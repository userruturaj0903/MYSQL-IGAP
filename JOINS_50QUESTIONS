1. INNER JOIN (10 Questions)
Q1. Display all students along with their city names.
SELECT s.Id, s.Name, s.Age, s.Score, c.CityName
FROM Student s
INNER JOIN City c
ON s.CityId = c.CityId;

Q2. Display student name and city tier.
SELECT s.Name, c.Tier
FROM Student s
INNER JOIN City c
ON s.CityId = c.CityId;

Q3. Display students from Tier-1 cities.
SELECT s.Name, c.CityName
FROM Student s
INNER JOIN City c
ON s.CityId = c.CityId
WHERE c.Tier='Tier-1';

Q4. Display students whose score is greater than 85.
SELECT s.Name, s.Score, c.CityName
FROM Student s
INNER JOIN City c
ON s.CityId=c.CityId
WHERE s.Score>85;

Q5. Count students in each city.
SELECT c.CityName, COUNT(*) AS TotalStudents
FROM Student s
INNER JOIN City c
ON s.CityId=c.CityId
GROUP BY c.CityName;

Q6. Find the average score of each city.
SELECT c.CityName, AVG(s.Score) AS AverageScore
FROM Student s
INNER JOIN City c
ON s.CityId=c.CityId
GROUP BY c.CityName;

Q7. Find the highest score city-wise.
SELECT c.CityName, MAX(s.Score) AS HighestScore
FROM Student s
INNER JOIN City c
ON s.CityId=c.CityId
GROUP BY c.CityName;

Q8. Display students from Pune.
SELECT s.Name, s.Score
FROM Student s
INNER JOIN City c
ON s.CityId=c.CityId
WHERE c.CityName='Pune';

Q9. Display all students ordered by city name.
SELECT s.Name, c.CityName
FROM Student s
INNER JOIN City c
ON s.CityId=c.CityId
ORDER BY c.CityName;

Q10. Find the total score city-wise.
SELECT c.CityName, SUM(s.Score) AS TotalScore
FROM Student s
INNER JOIN City c
ON s.CityId=c.CityId
GROUP BY c.CityName;

2. LEFT JOIN (10 Questions)
Q1. Display all students and their city details.
SELECT s.Name,c.CityName
FROM Student s
LEFT JOIN City c
ON s.CityId=c.CityId;

Q2. Display students even if city details are missing.
SELECT *
FROM Student s
LEFT JOIN City c
ON s.CityId=c.CityId;

Q3. Find students whose city does not exist.
SELECT s.*
FROM Student s
LEFT JOIN City c
ON s.CityId=c.CityId
WHERE c.CityId IS NULL;

Q4. Show all students with city tier.
SELECT s.Name,c.Tier
FROM Student s
LEFT JOIN City c
ON s.CityId=c.CityId;

Q5. Count students including missing cities.
SELECT c.CityName,COUNT(s.Id)
FROM Student s
LEFT JOIN City c
ON s.CityId=c.CityId
GROUP BY c.CityName;

Q6. Show student name and city.
SELECT s.Name,c.CityName
FROM Student s
LEFT JOIN City c
ON s.CityId=c.CityId;

Q7. Display students older than 22.
SELECT s.Name,c.CityName
FROM Student s
LEFT JOIN City c
ON s.CityId=c.CityId
WHERE s.Age>22;

Q8. Display students with score greater than average.
SELECT s.Name,c.CityName,s.Score
FROM Student s
LEFT JOIN City c
ON s.CityId=c.CityId
WHERE s.Score>
(
SELECT AVG(Score)
FROM Student
);

Q9. Display all student-city records ordered by score.
SELECT s.Name,c.CityName,s.Score
FROM Student s
LEFT JOIN City c
ON s.CityId=c.CityId
ORDER BY s.Score DESC;

Q10. Display total students city-wise.
SELECT c.CityName,COUNT(s.Id)
FROM Student s
LEFT JOIN City c
ON s.CityId=c.CityId
GROUP BY c.CityName;


