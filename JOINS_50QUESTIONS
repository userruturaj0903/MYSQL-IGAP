FROM Student s
CROSS JOIN City c
ORDER BY s.Name;

Q5. Show combinations ordered by city.
SELECT s.Name,c.CityName
FROM Student s
CROSS JOIN City c
ORDER BY c.CityName;

Q6. Students with cities having Tier-1.
SELECT s.Name,c.CityName
FROM Student s
CROSS JOIN City c
