# Common CRUD Procedure

```sql
DELIMITER $$

CREATE PROCEDURE ManageStudent
(
    IN pAction VARCHAR(20),
    IN pId INT,
    IN pName VARCHAR(100),
    IN pAge INT,
    IN pScore INT
)
BEGIN

    IF pAction='INSERT' THEN

        INSERT INTO Student(Name,Age,Score)
        VALUES(pName,pAge,pScore);

    ELSEIF pAction='UPDATE' THEN

        UPDATE Student
        SET
            Name=pName,
            Age=pAge,
            Score=pScore
        WHERE Id=pId;

    ELSEIF pAction='DELETE' THEN

        DELETE
        FROM Student
        WHERE Id=pId;

    ELSE

        SELECT 'Invalid Action' AS Message;

    END IF;

END $$

DELIMITER ;
```

---

## INSERT

```sql
CALL ManageStudent
(
'INSERT',
0,
'Rohan',
22,
95
);
```

